on early-init
    mount debugfs debugfs /sys/kernel/debug mode=755

on fs
    mkdir /data 0771 system system
    mkdir /mnt/vendor 0771 root root

on post-fs-data
    mkdir /data/misc 01771 system misc
    mkdir /data/vendor 0771 root root

# HAL services are started by the init fragments in the FlatBuild vendor image.
# No synthetic vendor service is defined here.
